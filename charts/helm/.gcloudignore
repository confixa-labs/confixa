```gitignore
# .gcloudignore - Exclude files from Google Cloud Marketplace package

# Build artifacts
build/
dist/
target/
*.tar.gz
*.tgz

# Development files
.git/
.gitignore
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
.tmp/
tmp/

# Log files
*.log
logs/

# Node.js (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (if any)
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/

# Documentation drafts (keep only final versions)
DRAFT-*.md
TODO.md
NOTES.md

# Local development overrides
values-local.yaml
values-dev.yaml
values-test.yaml
local-config.yaml

# Backup files
*.bak
*.backup
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Helm specific
.helmignore
charts/*.tgz

# Keep only necessary files for marketplace
# The following are INCLUDED:
# - Chart.yaml
# - values.yaml  
# - schema.yaml
# - application.yaml (in templates/)
# - Dockerfile
# - Makefile
# - README-Marketplace.md
# - templates/ directory
# - All template files (*.yaml in templates/)
```